# =============================================================================
# Newtown Express Environment Variables Template
# NOTE: Mock and sandbox modes are removed. Real Firebase and Brevo credentials
# are strictly required to run both in local development and in production.
# =============================================================================

# Server-Side Admin Configuration (Never leak to client)
# Comma-separated list of admin email addresses that receive role: "admin"
ADMIN_EMAILS="sudipta@ibarts.in,admin@genioussonu.me"

# Brevo (formerly Sendinblue) Transactional Email API (Free Tier: 300 emails/day)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified Sender Email in Brevo
# NOTE: If you do not control @ibarts.in DNS, verify a personal Gmail address in
# Brevo (Senders & IP -> Senders -> Add a sender) and set that email here.
BREVO_SENDER_EMAIL="your-verified-email@gmail.com"

# Firebase Admin SDK Service Account (Server-Side)
# Raw JSON string or Base64-encoded string of the Firebase service account key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com"}'

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="newtown-express.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="newtown-express"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="newtown-express.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXX"
