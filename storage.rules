rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && (request.auth.token.role in ['admin', 'kitchenManager']);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Standard Payment proof location (v2):
    // Path: /paymentProofs/{orderId}.jpg
    // Read: only staff (admin/kitchenManager) OR ordering employee (cross-referenced via Firestore order doc).
    // Note: Cross-collection read costs 1 Firestore read per view, which is acceptable and deliberate.
    // Write: direct client writes are prohibited. All writes strictly pass through server-side /api/orders/upload-proof.
    match /paymentProofs/{orderId}.jpg {
      allow read: if isAuthenticated() && (
        isStaff() ||
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.employeeId == request.auth.uid
      );
      allow write: if false;
    }

    // Legacy Payment proof uploads:
    // Path: /payment-proofs/{userId}/{fileName}
    match /payment-proofs/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow write: if isAuthenticated() &&
                     request.auth.uid == userId &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    // Legacy Payment screenshot uploads keyed by orderId:
    // Path: /payment-screenshots/{orderId}/{fileName}
    match /payment-screenshots/{orderId}/{fileName} {
      allow read: if isAuthenticated() && (
        isStaff() ||
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.employeeId == request.auth.uid
      );
      allow write: if isAuthenticated() &&
                     (isStaff() || firestore.get(/databases/(default)/documents/orders/$(orderId)).data.employeeId == request.auth.uid) &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    // Profile picture uploads:
    // Path: /profile-pictures/{uid}/{fileName}
    match /profile-pictures/{uid}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
                     request.auth.uid == uid &&
                     request.resource.size < 500 * 1024 &&
                     request.resource.contentType.matches('image/(webp|jpeg)');
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
